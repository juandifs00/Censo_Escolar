# ── Servidor ──────────────────────────────────────────────────────────────
# Puerto en el que corre el servidor Express (Railway/Render lo inyectan automáticamente)
PORT=3000

# ── Autenticación del Panel de Administración ─────────────────────────────
# OBLIGATORIO: cambie este valor antes de hacer deploy.
# Nunca use la contraseña de ejemplo en producción.
ADMIN_PASSWORD=CambieEstaContraseñaAntesDeDeploy2026!

# ── Entorno ───────────────────────────────────────────────────────────────
# En producción, establezca esto como "production"
NODE_ENV=development
